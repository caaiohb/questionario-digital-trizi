# Supabase público
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Somente servidor. Nunca use NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# URL pública de produção. Ex.: https://questionario.institutotrizi.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredos longos e aleatórios, com no mínimo 32 caracteres
RATE_LIMIT_SECRET=troque-por-um-segredo-longo-e-aleatorio
AUDIT_HASH_SECRET=troque-por-outro-segredo-longo-e-aleatorio

# Notificação opcional de alerta prioritário
RESEND_API_KEY=
ALERT_EMAIL_FROM=alertas@seudominio.com.br

# Permite executar seed fictício somente em desenvolvimento
ALLOW_DEV_SEED=false

# Somente para seed local fictício
DEV_ADMIN_PASSWORD=
DEV_EMPLOYEE_PASSWORD=
